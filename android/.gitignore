/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Never share a signing keystore. Whoever holds this file can publish updates
# to the Play Store listing as if they were you, and Play will not let the real
# owner back in without it.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# PKCS12 is what `keytool -genkeypair -storetype PKCS12` produces, and the
# format Android Studio recommends. It is not covered by the *.jks rule above.
**/*.p12
**/*.pfx
# The template stays tracked, so the expected keys are documented in the repo.
!key.properties.example
